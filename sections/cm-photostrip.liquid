<script
  src="{{ 'cm-photostrip.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
%}

<cm-photostrip
  class="cm-photostrip"
  data-frame-delay="780"
  data-flash-duration="160"
  aria-labelledby="cm-photostrip-heading-{{ section.id }}"
>
  <div class="cm-photostrip__intro">
    {% if eyebrow != blank %}
      <p class="cm-photostrip__eyebrow">{{ eyebrow }}</p>
    {% endif %}
    {% if heading != blank %}
      <h2 class="cm-photostrip__heading" id="cm-photostrip-heading-{{ section.id }}">{{ heading }}</h2>
    {% endif %}
  </div>

  <div class="cm-photostrip__stage">
    <div class="cm-photostrip__flash" ref="flash" aria-hidden="true"></div>

    <div
      class="cm-photostrip__track"
      role="list"
      ref="strip"
      tabindex="0"
      aria-label="Photo strip frames"
    >
      {% for block in section.blocks %}
        <figure
          class="cm-photostrip__frame"
          role="listitem"
          data-cm-frame
          ref="frames[]"
          style="--frame-index: {{ forloop.index0 }};"
          {{ block.shopify_attributes }}
        >
          <div class="cm-photostrip__slot">
            <div class="cm-photostrip__shutter" aria-hidden="true"></div>
            {% liquid
              assign frame_alt = block.settings.caption | default: 'Photo booth frame'
              assign fallback_asset = blank
              if forloop.index <= 4
                assign fallback_asset = 'cm-frame-0' | append: forloop.index | append: '.png'
              endif
            %}
            {% if block.settings.image != blank %}
              {% liquid
                assign frame_alt = block.settings.image.alt | default: frame_alt
              %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  class: 'cm-photostrip__img',
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 22vw, 70vw',
                  widths: '400, 600, 900',
                  alt: frame_alt
              }}
            {% elsif fallback_asset != blank %}
              <img
                class="cm-photostrip__img"
                src="{{ fallback_asset | asset_url }}"
                alt="{{ frame_alt | escape }}"
                width="600"
                height="800"
                loading="lazy"
              >
            {% else %}
              <div class="cm-photostrip__empty" aria-hidden="true"></div>
            {% endif %}
          </div>
          {% if block.settings.caption != blank %}
            <figcaption class="cm-photostrip__caption">{{ block.settings.caption }}</figcaption>
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  </div>
</cm-photostrip>

{% stylesheet %}
  .cm-photostrip {
    display: grid;
    gap: 1.75rem;
    padding-block: clamp(3rem, 8vw, 5.5rem);
    padding-inline: 0;
    background: color-mix(in srgb, var(--cm-blush) 55%, var(--cm-cream));
    overflow-x: clip;
    overflow-y: visible;
    min-width: 0;
  }

  .cm-photostrip__intro {
    width: min(100% - 2.5rem, 70rem);
    margin-inline: auto;
    display: grid;
    gap: 0.4rem;
  }

  .cm-photostrip__eyebrow {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cm-burgundy);
  }

  .cm-photostrip__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    color: var(--cm-ink);
  }

  .cm-photostrip__stage {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .cm-photostrip__flash {
    position: absolute;
    inset: -4% 0;
    z-index: 5;
    pointer-events: none;
    background: radial-gradient(circle at center, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.25) 40%, transparent 70%);
    opacity: 0;
    mix-blend-mode: screen;
  }

  .cm-photostrip__flash.is-on {
    animation: cm-booth-flash 160ms ease-out;
  }

  .cm-photostrip__track {
    --cm-frame-width: min(72vw, 18rem);
    display: flex;
    align-items: stretch;
    gap: 1rem;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding-inline: clamp(1.25rem, 4vw, 4rem);
    padding-block-end: 0.35rem;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: var(--cm-burgundy) transparent;
  }

  .cm-photostrip__track::-webkit-scrollbar {
    height: 0.35rem;
  }

  .cm-photostrip__track::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--cm-burgundy) 70%, transparent);
  }

  .cm-photostrip.is-auto-scrolling .cm-photostrip__track {
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  .cm-photostrip__frame {
    margin: 0;
    flex: 0 0 var(--cm-frame-width);
    width: var(--cm-frame-width);
    max-width: var(--cm-frame-width);
    scroll-snap-align: start;
    background: var(--cm-cream);
    border: 1px solid color-mix(in srgb, var(--cm-taupe) 80%, transparent);
    padding: 0.7rem 0.7rem 1rem;
    box-shadow: 0 18px 40px rgb(var(--color-foreground-rgb) / 0.08);
    transform-origin: center bottom;
    opacity: 1;
  }

  .cm-photostrip__frame:nth-child(even) {
    transform: rotate(1.2deg);
  }

  .cm-photostrip__frame:nth-child(odd) {
    transform: rotate(-1deg);
  }

  /* Only hide unprinted frames when JS is driving the booth animation. */
  .cm-photostrip.is-enhanced .cm-photostrip__frame:not(.is-printed) {
    opacity: 0;
    transform: translateY(22px) rotate(0deg) scale(0.98);
  }

  .cm-photostrip__frame.is-printed {
    animation: cm-booth-print 480ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .cm-photostrip__frame.is-printed:nth-child(even) {
    animation-name: cm-booth-print-even;
  }

  .cm-photostrip__frame.is-printed:nth-child(odd) {
    animation-name: cm-booth-print-odd;
  }

  .cm-photostrip__frame.is-printed:hover {
    transform: rotate(0deg) translateY(-6px);
    transition: transform 220ms ease;
  }

  .cm-photostrip__slot {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--cm-ink);
  }

  .cm-photostrip__shutter {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--cm-ink);
    transition: opacity 120ms ease, background 80ms ease;
  }

  .cm-photostrip__frame.is-flashing .cm-photostrip__shutter {
    background: #fff;
    opacity: 1;
  }

  .cm-photostrip__frame.is-printed .cm-photostrip__shutter,
  .cm-photostrip:not(.is-enhanced) .cm-photostrip__shutter {
    opacity: 0;
    pointer-events: none;
  }

  .cm-photostrip__img,
  .cm-photostrip__empty {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(0.9);
    transform: scale(1);
    opacity: 1;
    transition: transform 560ms ease, opacity 560ms ease, filter 560ms ease;
  }

  .cm-photostrip.is-enhanced .cm-photostrip__frame:not(.is-printed) .cm-photostrip__img,
  .cm-photostrip.is-enhanced .cm-photostrip__frame:not(.is-printed) .cm-photostrip__empty {
    transform: scale(1.05);
    opacity: 0.7;
    filter: contrast(1.08) saturate(0.88);
  }

  .cm-photostrip__frame.is-printed .cm-photostrip__img,
  .cm-photostrip__frame.is-printed .cm-photostrip__empty {
    transform: scale(1);
    opacity: 1;
    filter: contrast(1.05) saturate(0.9);
  }

  .cm-photostrip__empty {
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--cm-red) 70%, black), var(--cm-burgundy));
  }

  .cm-photostrip__caption {
    margin-block-start: 0.65rem;
    font-family: var(--font-accent--family);
    font-size: 1.35rem;
    line-height: 1;
    text-align: center;
    color: var(--cm-burgundy);
    opacity: 1;
    transform: translateY(0);
    transition: opacity 260ms ease 70ms, transform 260ms ease 70ms;
  }

  .cm-photostrip.is-enhanced .cm-photostrip__frame:not(.is-printed) .cm-photostrip__caption {
    opacity: 0;
    transform: translateY(6px);
  }

  .cm-photostrip__frame.is-printed .cm-photostrip__caption {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes cm-booth-flash {
    0% {
      opacity: 0;
    }

    20% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes cm-booth-print-odd {
    0% {
      opacity: 0;
      transform: translateY(22px) rotate(0deg) scale(0.98);
    }

    100% {
      opacity: 1;
      transform: translateY(0) rotate(-1deg) scale(1);
    }
  }

  @keyframes cm-booth-print-even {
    0% {
      opacity: 0;
      transform: translateY(22px) rotate(0deg) scale(0.98);
    }

    100% {
      opacity: 1;
      transform: translateY(0) rotate(1.2deg) scale(1);
    }
  }

  @media screen and (min-width: 900px) {
    .cm-photostrip__track {
      --cm-frame-width: min(22vw, 18rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cm-photostrip__frame,
    .cm-photostrip__img,
    .cm-photostrip__empty,
    .cm-photostrip__caption,
    .cm-photostrip__shutter {
      transition: none;
      animation: none;
    }

    .cm-photostrip__frame,
    .cm-photostrip__frame.is-printed,
    .cm-photostrip__frame.is-printed .cm-photostrip__img,
    .cm-photostrip__frame.is-printed .cm-photostrip__empty,
    .cm-photostrip__frame.is-printed .cm-photostrip__caption {
      opacity: 1;
      transform: none;
    }

    .cm-photostrip__frame:nth-child(even) {
      transform: rotate(1.2deg);
    }

    .cm-photostrip__frame:nth-child(odd) {
      transform: rotate(-1deg);
    }

    .cm-photostrip__shutter {
      opacity: 0;
    }

    .cm-photostrip__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CM Photo strip",
  "tag": "section",
  "class": "section-cm-photostrip",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The booth"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Four frames. Forever."
    }
  ],
  "blocks": [
    {
      "type": "frame",
      "name": "Frame",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "frame"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CM Photo strip",
      "blocks": [
        { "type": "frame", "settings": { "caption": "one" } },
        { "type": "frame", "settings": { "caption": "two" } },
        { "type": "frame", "settings": { "caption": "three" } },
        { "type": "frame", "settings": { "caption": "four" } }
      ]
    }
  ]
}
{% endschema %}
