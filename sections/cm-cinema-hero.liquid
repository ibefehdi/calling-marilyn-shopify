{% liquid
  assign hero_heading = section.settings.heading | default: shop.name
  assign hero_script = section.settings.script_line
  assign hero_tagline = section.settings.tagline
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign ribbon_text = section.settings.ribbon_text | default: 'PHOTOS'
%}

<section
  class="cm-hero"
  style="
    --cm-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  <div class="cm-hero__media" aria-hidden="true">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'cm-hero__media-img',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '800, 1200, 1600, 2000, 2400',
          alt: ''
      }}
    {% else %}
      {{
        'cm-hero-banner.png'
        | asset_url
        | image_tag:
          class: 'cm-hero__media-img',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '800, 1200, 1600, 2000, 2400',
          alt: ''
      }}
    {% endif %}
    <div class="cm-hero__veil"></div>
  </div>

  <div class="cm-hero__ribbon" aria-hidden="true">
    <span class="cm-hero__ribbon-text">{{ ribbon_text }}</span>
  </div>

  <div class="cm-hero__content">
    {% if hero_script != blank %}
      <p class="cm-hero__script">{{ hero_script }}</p>
    {% endif %}

    <h1 class="cm-hero__title">
      <span class="visually-hidden">{{ hero_heading }}</span>
      {% render 'cm-logo', class: 'cm-hero__logo', height: 72, alt: hero_heading %}
    </h1>

    {% if hero_tagline != blank %}
      <p class="cm-hero__tagline">{{ hero_tagline }}</p>
    {% endif %}

    {% if cta_label != blank %}
      <a
        class="cm-hero__cta"
        href="{{ cta_link | default: routes.root_url }}"
        {% if section.settings.cta_new_tab %}
          target="_blank"
          rel="noopener noreferrer"
        {% endif %}
      >
        {{ cta_label }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cm-hero {
    --cm-hero-min-height: 100svh;
    position: relative;
    isolation: isolate;
    min-height: var(--cm-hero-min-height);
    display: grid;
    align-items: end;
    overflow: clip;
    color: var(--cm-cream);
    background: var(--cm-ink);
  }

  .cm-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cm-hero__media-img,
  .cm-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: cm-hero-drift 28s ease-in-out infinite alternate;
  }

  .cm-hero__placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--cm-red) 55%, transparent), transparent 45%),
      linear-gradient(145deg, var(--cm-burgundy), var(--cm-ink));
  }

  .cm-hero__placeholder-mark {
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 8vw, 6rem);
    letter-spacing: 0.02em;
    opacity: 0.35;
  }

  .cm-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgb(var(--color-foreground-rgb) / calc(0.55 + var(--cm-hero-overlay))) 0%,
        rgb(var(--color-foreground-rgb) / calc(0.28 + var(--cm-hero-overlay) * 0.4)) 42%,
        rgb(var(--color-foreground-rgb) / 0.08) 72%,
        transparent 100%
      ),
      linear-gradient(
        to top,
        rgb(var(--color-foreground-rgb) / calc(0.35 + var(--cm-hero-overlay) * 0.5)) 0%,
        transparent 42%
      );
  }

  .cm-hero__ribbon {
    position: absolute;
    top: 0;
    right: clamp(0.75rem, 3vw, 2rem);
    z-index: 2;
    height: 100%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    background: var(--cm-cream);
    color: var(--cm-burgundy);
    border-inline: 1px solid color-mix(in srgb, var(--cm-taupe) 70%, transparent);
  }

  .cm-hero__ribbon-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.42em;
    text-transform: uppercase;
  }

  .cm-hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1rem;
    width: min(100% - 2.5rem, 42rem);
    margin-inline: clamp(1.25rem, 4vw, 4rem);
    margin-block-end: clamp(2.5rem, 8vh, 5rem);
    padding-inline-end: 3.5rem;
  }

  .cm-hero__script {
    margin: 0;
    font-family: var(--font-accent--family);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1;
    color: color-mix(in srgb, var(--cm-cream) 92%, var(--cm-blush));
  }

  .cm-hero__title {
    margin: 0;
    line-height: 0.9;
  }

  .cm-hero__logo {
    display: block;
    width: min(100%, 22rem);
    height: auto;
    max-height: clamp(3.5rem, 10vw, 5.5rem);
    object-fit: contain;
    object-position: left center;
    filter: drop-shadow(0 2px 18px rgb(0 0 0 / 0.35));
  }

  .cm-hero__tagline {
    margin: 0;
    max-width: 28ch;
    font-family: var(--font-body--family);
    font-size: clamp(1rem, 2.1vw, 1.2rem);
    line-height: 1.45;
    color: color-mix(in srgb, var(--cm-cream) 88%, transparent);
  }

  .cm-hero__cta {
    justify-self: start;
    margin-block-start: 0.5rem;
    padding: 0.9rem 1.4rem;
    border: 1px solid var(--cm-cream);
    background: var(--cm-red);
    color: var(--cm-cream);
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .cm-hero__cta:hover {
    background: var(--cm-cream);
    color: var(--cm-burgundy);
    border-color: var(--cm-cream);
  }

  .cm-hero__cta:focus-visible {
    outline: 3px solid var(--cm-cream);
    outline-offset: 3px;
  }

  @keyframes cm-hero-drift {
    from {
      transform: scale(1.04) translate3d(0, 0, 0);
    }

    to {
      transform: scale(1.1) translate3d(-1.5%, 1%, 0);
    }
  }

  @media screen and (max-width: 749px) {
    .cm-hero__ribbon {
      width: 2.1rem;
      right: 0.5rem;
    }

    .cm-hero__content {
      padding-inline-end: 2.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CM Cinema hero",
  "tag": "section",
  "class": "section-cm-cinema-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Optional. Leave empty to use the default Calling Marilyn banner."
    },
    {
      "type": "text",
      "id": "script_line",
      "label": "Script line",
      "default": "presents"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Calling Marilyn"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "An event lasts a day. A photo lasts forever."
    },
    {
      "type": "text",
      "id": "ribbon_text",
      "label": "Side ribbon",
      "default": "PHOTOS"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Find the booth"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "cta_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay strength",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 25,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "CM Cinema hero"
    }
  ]
}
{% endschema %}
