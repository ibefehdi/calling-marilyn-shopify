{% liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign intro = section.settings.intro
  assign bg = section.settings.background_color
%}

<section
  class="cm-pillars"
  id="{{ section.settings.anchor_id | default: 'start' | handleize }}"
  aria-labelledby="cm-pillars-heading-{{ section.id }}"
  style="
    --cm-pillars-pad-top: {{ section.settings.padding_top }}px;
    --cm-pillars-pad-bottom: {{ section.settings.padding_bottom }}px;
    {% if bg != blank %}--cm-pillars-bg: {{ bg }};{% endif %}
  "
>
  <div class="cm-pillars__inner">
    <header class="cm-pillars__header">
      {% if eyebrow != blank %}
        <p class="cm-pillars__eyebrow">{{ eyebrow }}</p>
      {% endif %}
      {% if heading != blank %}
        <h2 class="cm-pillars__heading" id="cm-pillars-heading-{{ section.id }}">{{ heading }}</h2>
      {% else %}
        <h2 class="visually-hidden" id="cm-pillars-heading-{{ section.id }}">Book, Shop & Drop</h2>
      {% endif %}
      {% if intro != blank %}
        <p class="cm-pillars__intro">{{ intro }}</p>
      {% endif %}
    </header>

    <nav class="cm-pillars__nav" aria-label="{{ section.settings.nav_label | default: 'Book, Shop and Drop' }}">
      <ul class="cm-pillars__list" role="list">
        {% for block in section.blocks %}
          <li class="cm-pillars__item" {{ block.shopify_attributes }}>
            <a class="cm-pillars__card" href="{{ block.settings.link | default: '#book' }}">
              {% if block.settings.kicker != blank %}
                <span class="cm-pillars__kicker">{{ block.settings.kicker }}</span>
              {% endif %}
              <span class="cm-pillars__title">{{ block.settings.title }}</span>
              {% if block.settings.text != blank %}
                <span class="cm-pillars__text">{{ block.settings.text }}</span>
              {% endif %}
              <span class="cm-pillars__cta">
                {{ block.settings.cta_label | default: 'Explore' }}
                <span aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</section>

{% stylesheet %}
  .cm-pillars {
    --cm-pillars-bg: color-mix(in srgb, var(--cm-blush) 40%, var(--cm-cream));
    padding-block: var(--cm-pillars-pad-top, 3.5rem) var(--cm-pillars-pad-bottom, 3.5rem);
    background: var(--cm-pillars-bg);
    border-block: 1px solid color-mix(in srgb, var(--cm-gold) 45%, transparent);
  }

  .cm-pillars__inner {
    width: min(100% - 2.5rem, 70rem);
    margin-inline: auto;
    display: grid;
    gap: 2rem;
  }

  .cm-pillars__header {
    display: grid;
    gap: 0.65rem;
    max-width: 36rem;
  }

  .cm-pillars__eyebrow {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cm-burgundy);
  }

  .cm-pillars__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.4rem, 6vw, 4.25rem);
    line-height: 0.95;
    color: var(--cm-ink);
  }

  .cm-pillars__intro {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--cm-ink) 75%, transparent);
  }

  .cm-pillars__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .cm-pillars__card {
    display: grid;
    gap: 0.55rem;
    min-height: 100%;
    padding: 1.35rem 1.25rem;
    text-decoration: none;
    color: inherit;
    background: var(--cm-cream);
    border: 1px solid color-mix(in srgb, var(--cm-gold) 55%, var(--cm-taupe));
    border-inline-start: 3px solid var(--cm-burgundy);
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .cm-pillars__card:hover {
    transform: translateY(-3px);
    border-color: var(--cm-gold);
    background: color-mix(in srgb, var(--cm-cream) 92%, var(--cm-blush));
  }

  .cm-pillars__card:focus-visible {
    outline: 3px solid var(--cm-red);
    outline-offset: 3px;
  }

  .cm-pillars__kicker {
    font-family: var(--font-subheading--family);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cm-gold-deep);
  }

  .cm-pillars__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    line-height: 1;
    color: var(--cm-ink);
  }

  .cm-pillars__text {
    font-size: 0.98rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--cm-ink) 72%, transparent);
  }

  .cm-pillars__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: 0.35rem;
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cm-burgundy);
  }

  @media screen and (min-width: 900px) {
    .cm-pillars__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CM Book Shop Drop",
  "tag": "section",
  "class": "section-cm-pillars",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section ID",
      "default": "start"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Calling Marilyn"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Book. Shop. Drop."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Three ways into the booth — reserve a moment, take home merch, or drop us a line."
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Nav accessibility label",
      "default": "Book, Shop and Drop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "info": "Leave blank for the brand blush mix."
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Book"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Reserve a booth for your party, launch, or private night."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Link label",
          "default": "See booths"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CM Book Shop Drop",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "kicker": "01",
            "title": "Book",
            "text": "Reserve a booth for your party, launch, or private night.",
            "link": "#book",
            "cta_label": "See booths"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "kicker": "02",
            "title": "Shop",
            "text": "Frames, merch, and keepsakes from the booth — coming soon and live drops.",
            "link": "#shop",
            "cta_label": "Browse shop"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "kicker": "03",
            "title": "Drop",
            "text": "Message us, share a suggestion, or request a custom booth at your space.",
            "link": "#drop",
            "cta_label": "Drop a note"
          }
        }
      ]
    }
  ]
}
{% endschema %}
