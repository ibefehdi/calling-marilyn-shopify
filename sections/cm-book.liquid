{% liquid
  assign product_tag = section.settings.product_tag | default: 'Book' | strip
  assign max_products = section.settings.max_products | default: 8
  assign empty_message = section.settings.empty_message
  assign cta_label = section.settings.card_cta_label | default: 'View booth'
  assign shown = 0
  assign bg = section.settings.background_color

  if section.settings.collection != blank
    assign source_products = section.settings.collection.products
  else
    assign source_products = collections.all.products
  endif
%}

<section
  class="cm-book"
  id="{{ section.settings.anchor_id | default: 'book' | handleize }}"
  aria-labelledby="cm-book-heading-{{ section.id }}"
  style="
    --cm-book-pad-top: {{ section.settings.padding_top }}px;
    --cm-book-pad-bottom: {{ section.settings.padding_bottom }}px;
    {% if bg != blank %}--cm-book-bg: {{ bg }};{% endif %}
  "
>
  <div class="cm-book__inner">
    <header class="cm-book__header">
      {% if section.settings.eyebrow != blank %}
        <p class="cm-book__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="cm-book__heading" id="cm-book-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% else %}
        <h2 class="visually-hidden" id="cm-book-heading-{{ section.id }}">Book</h2>
      {% endif %}
      {% if section.settings.intro != blank %}
        <p class="cm-book__intro">{{ section.settings.intro }}</p>
      {% endif %}
    </header>

    <ul class="cm-book__grid" role="list">
      {% for product in source_products %}
        {% if shown >= max_products %}
          {% break %}
        {% endif %}

        {% liquid
          assign matches_tag = false
          if product_tag == blank
            assign matches_tag = true
          elsif product.tags contains product_tag
            assign matches_tag = true
          endif
        %}

        {% if matches_tag %}
          {% assign shown = shown | plus: 1 %}
          <li class="cm-book__card">
            <a class="cm-book__link" href="{{ product.url }}">
              <div class="cm-book__media">
                {% if product.featured_media != blank %}
                  {% liquid
                    assign book_alt = product.featured_media.alt | default: product.title
                  %}
                  {{
                    product.featured_media
                    | image_url: width: 900
                    | image_tag:
                      class: 'cm-book__img',
                      loading: 'lazy',
                      sizes: '(min-width: 900px) 22vw, 70vw',
                      widths: '400, 600, 900',
                      alt: book_alt
                  }}
                {% else %}
                  <div class="cm-book__placeholder" aria-hidden="true">
                    <span>{{ product.title | slice: 0 }}</span>
                  </div>
                {% endif %}
              </div>
              <div class="cm-book__body">
                <h3 class="cm-book__title">{{ product.title }}</h3>
                {% if section.settings.show_price %}
                  <p class="cm-book__price">
                    {% if product.price_varies %}
                      From {{ product.price_min | money }}
                    {% else %}
                      {{ product.price | money }}
                    {% endif %}
                  </p>
                {% endif %}
                {% if product.description != blank and section.settings.show_excerpt %}
                  <p class="cm-book__excerpt">{{ product.description | strip_html | truncate: 110 }}</p>
                {% endif %}
                <span class="cm-book__cta">{{ cta_label }} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>

    {% if shown == 0 %}
      <p class="cm-book__empty" role="status">
        {{ empty_message | default: 'Booth bookings are being staged — check back soon.' }}
      </p>
    {% endif %}

    {% if section.settings.view_all_label != blank and section.settings.view_all_link != blank %}
      <a class="cm-book__view-all" href="{{ section.settings.view_all_link }}">
        {{ section.settings.view_all_label }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cm-book {
    --cm-book-bg: var(--cm-cream);
    padding-block: var(--cm-book-pad-top, 4.5rem) var(--cm-book-pad-bottom, 4.5rem);
    background: var(--cm-book-bg);
  }

  .cm-book__inner {
    width: min(100% - 2.5rem, 70rem);
    margin-inline: auto;
    display: grid;
    gap: 2rem;
  }

  .cm-book__header {
    display: grid;
    gap: 0.65rem;
    max-width: 38rem;
  }

  .cm-book__eyebrow {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cm-burgundy);
  }

  .cm-book__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 0.95;
    color: var(--cm-ink);
  }

  .cm-book__intro {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--cm-ink) 75%, transparent);
  }

  .cm-book__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  .cm-book__link {
    display: grid;
    gap: 0.9rem;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .cm-book__link:focus-visible {
    outline: 3px solid var(--cm-red);
    outline-offset: 3px;
  }

  .cm-book__media {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--cm-gold) 55%, var(--cm-taupe));
    background: var(--cm-blush);
    aspect-ratio: 4 / 5;
  }

  .cm-book__img,
  .cm-book__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cm-book__placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, var(--cm-burgundy), var(--cm-ink));
    color: color-mix(in srgb, var(--cm-cream) 60%, transparent);
    font-family: var(--font-heading--family);
    font-size: 3rem;
  }

  .cm-book__body {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .cm-book__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.35rem, 2.5vw, 1.7rem);
    line-height: 1.1;
  }

  .cm-book__price {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--cm-burgundy);
  }

  .cm-book__excerpt {
    margin: 0.15rem 0 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--cm-ink) 70%, transparent);
  }

  .cm-book__cta {
    margin-block-start: 0.35rem;
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cm-red);
  }

  .cm-book__link:hover .cm-book__cta {
    color: var(--cm-burgundy);
  }

  .cm-book__empty {
    margin: 0;
    padding: 1.25rem 1.1rem;
    border: 1px dashed color-mix(in srgb, var(--cm-gold) 70%, var(--cm-taupe));
    color: color-mix(in srgb, var(--cm-ink) 75%, transparent);
  }

  .cm-book__view-all {
    justify-self: start;
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--cm-burgundy);
    color: var(--cm-burgundy);
    text-decoration: none;
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cm-book__view-all:hover {
    background: var(--cm-burgundy);
    color: var(--cm-cream);
  }

  .cm-book__view-all:focus-visible {
    outline: 3px solid var(--cm-red);
    outline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .cm-book__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1100px) {
    .cm-book__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CM Book booths",
  "tag": "section",
  "class": "section-cm-book",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section ID",
      "default": "book"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Book"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Book the booth"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Pick a booth experience — parties, launches, and private nights. Tap through for details and booking info."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "text",
      "id": "product_tag",
      "label": "Product tag",
      "default": "Book",
      "info": "Shows products that include this tag (case-sensitive). Leave blank to show all from the collection."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Optional. Defaults to all products, then filters by tag."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Card button label",
      "default": "View booth"
    },
    {
      "type": "textarea",
      "id": "empty_message",
      "label": "Empty message",
      "default": "Booth bookings are being staged — check back soon."
    },
    {
      "type": "header",
      "content": "View all"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "info": "Leave blank for brand cream."
    }
  ],
  "presets": [
    {
      "name": "CM Book booths"
    }
  ]
}
{% endschema %}
