{% liquid
  assign exclude_tag = section.settings.exclude_tag | default: 'Book' | strip
  assign max_products = section.settings.max_products | default: 8
  assign empty_message = section.settings.empty_message
  assign cta_label = section.settings.card_cta_label | default: 'Shop'
  assign shown = 0
  assign merch_note = section.settings.merch_note
  assign bg = section.settings.background_color

  if section.settings.collection != blank
    assign source_products = section.settings.collection.products
  else
    assign source_products = collections.all.products
  endif
%}

<section
  class="cm-shop"
  id="{{ section.settings.anchor_id | default: 'shop' | handleize }}"
  aria-labelledby="cm-shop-heading-{{ section.id }}"
  style="
    --cm-shop-pad-top: {{ section.settings.padding_top }}px;
    --cm-shop-pad-bottom: {{ section.settings.padding_bottom }}px;
    {% if bg != blank %}--cm-shop-bg: {{ bg }};{% endif %}
  "
>
  <div class="cm-shop__inner">
    <header class="cm-shop__header">
      {% if section.settings.eyebrow != blank %}
        <p class="cm-shop__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="cm-shop__heading" id="cm-shop-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% else %}
        <h2 class="visually-hidden" id="cm-shop-heading-{{ section.id }}">Shop</h2>
      {% endif %}
      {% if section.settings.intro != blank %}
        <p class="cm-shop__intro">{{ section.settings.intro }}</p>
      {% endif %}
      {% if merch_note != blank %}
        <p class="cm-shop__note">{{ merch_note }}</p>
      {% endif %}
    </header>

    <ul class="cm-shop__grid" role="list">
      {% for product in source_products %}
        {% if shown >= max_products %}
          {% break %}
        {% endif %}

        {% liquid
          assign is_book = false
          if exclude_tag != blank and product.tags contains exclude_tag
            assign is_book = true
          endif
        %}

        {% unless is_book %}
          {% assign shown = shown | plus: 1 %}
          <li class="cm-shop__card">
            <a class="cm-shop__link" href="{{ product.url }}">
              <div class="cm-shop__media">
                {% if product.featured_media != blank %}
                  {% liquid
                    assign shop_alt = product.featured_media.alt | default: product.title
                  %}
                  {{
                    product.featured_media
                    | image_url: width: 900
                    | image_tag:
                      class: 'cm-shop__img',
                      loading: 'lazy',
                      sizes: '(min-width: 900px) 22vw, 70vw',
                      widths: '400, 600, 900',
                      alt: shop_alt
                  }}
                {% else %}
                  <div class="cm-shop__placeholder" aria-hidden="true">
                    <span>{{ product.title | slice: 0 }}</span>
                  </div>
                {% endif %}
              </div>
              <div class="cm-shop__body">
                <h3 class="cm-shop__title">{{ product.title }}</h3>
                {% if section.settings.show_price %}
                  <p class="cm-shop__price">
                    {% if product.price_varies %}
                      From {{ product.price_min | money }}
                    {% else %}
                      {{ product.price | money }}
                    {% endif %}
                  </p>
                {% endif %}
                <span class="cm-shop__cta">{{ cta_label }} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        {% endunless %}
      {% endfor %}
    </ul>

    {% if shown == 0 %}
      <div class="cm-shop__empty" role="status">
        <p class="cm-shop__empty-title">{{ section.settings.empty_heading | default: 'Merch is on the way' }}</p>
        <p class="cm-shop__empty-text">
          {{ empty_message | default: 'We’re working on getting the merchandise ready. Drop your email in the footer or follow Instagram for the first drop.' }}
        </p>
        {% if section.settings.empty_cta_label != blank and section.settings.empty_cta_link != blank %}
          <a class="cm-shop__empty-cta" href="{{ section.settings.empty_cta_link }}">
            {{ section.settings.empty_cta_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if shown > 0 and section.settings.view_all_label != blank and section.settings.view_all_link != blank %}
      <a class="cm-shop__view-all" href="{{ section.settings.view_all_link }}">
        {{ section.settings.view_all_label }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cm-shop {
    --cm-shop-bg: color-mix(in srgb, var(--cm-blush) 35%, var(--cm-cream));
    padding-block: var(--cm-shop-pad-top, 4.5rem) var(--cm-shop-pad-bottom, 4.5rem);
    background: var(--cm-shop-bg);
  }

  .cm-shop__inner {
    width: min(100% - 2.5rem, 70rem);
    margin-inline: auto;
    display: grid;
    gap: 2rem;
  }

  .cm-shop__header {
    display: grid;
    gap: 0.65rem;
    max-width: 38rem;
  }

  .cm-shop__eyebrow {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cm-burgundy);
  }

  .cm-shop__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 0.95;
    color: var(--cm-ink);
  }

  .cm-shop__intro {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--cm-ink) 75%, transparent);
  }

  .cm-shop__note {
    margin: 0.25rem 0 0;
    justify-self: start;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--cm-gold);
    font-family: var(--font-subheading--family);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cm-gold-deep);
  }

  .cm-shop__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cm-shop__link {
    display: grid;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .cm-shop__link:focus-visible {
    outline: 3px solid var(--cm-red);
    outline-offset: 3px;
  }

  .cm-shop__media {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--cm-gold) 55%, var(--cm-taupe));
    background: var(--cm-cream);
    aspect-ratio: 1;
  }

  .cm-shop__img,
  .cm-shop__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cm-shop__placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, var(--cm-red), var(--cm-burgundy));
    color: color-mix(in srgb, var(--cm-cream) 55%, transparent);
    font-family: var(--font-heading--family);
    font-size: 2.5rem;
  }

  .cm-shop__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.2rem;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .cm-shop__price {
    margin: 0;
    font-size: 0.9rem;
    color: var(--cm-burgundy);
  }

  .cm-shop__cta {
    font-family: var(--font-subheading--family);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cm-red);
  }

  .cm-shop__empty {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid color-mix(in srgb, var(--cm-gold) 60%, var(--cm-taupe));
    background: var(--cm-cream);
    max-width: 36rem;
  }

  .cm-shop__empty-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    line-height: 1;
  }

  .cm-shop__empty-text {
    margin: 0;
    line-height: 1.55;
    color: color-mix(in srgb, var(--cm-ink) 75%, transparent);
  }

  .cm-shop__empty-cta,
  .cm-shop__view-all {
    justify-self: start;
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--cm-burgundy);
    color: var(--cm-burgundy);
    text-decoration: none;
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cm-shop__empty-cta:hover,
  .cm-shop__view-all:hover {
    background: var(--cm-burgundy);
    color: var(--cm-cream);
  }

  .cm-shop__empty-cta:focus-visible,
  .cm-shop__view-all:focus-visible {
    outline: 3px solid var(--cm-red);
    outline-offset: 3px;
  }

  @media screen and (min-width: 900px) {
    .cm-shop__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CM Shop",
  "tag": "section",
  "class": "section-cm-shop",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section ID",
      "default": "shop"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the moment"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Frames, merch, and keepsakes from the booth."
    },
    {
      "type": "text",
      "id": "merch_note",
      "label": "Status note",
      "default": "Merchandise in progress"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "text",
      "id": "exclude_tag",
      "label": "Exclude tag",
      "default": "Book",
      "info": "Hides booking products so this rail stays merch-only."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Optional. Defaults to all products, then excludes the tag above."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Card button label",
      "default": "Shop"
    },
    {
      "type": "header",
      "content": "Empty state"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty heading",
      "default": "Merch is on the way"
    },
    {
      "type": "textarea",
      "id": "empty_message",
      "label": "Empty message",
      "default": "We’re working on getting the merchandise ready. Follow Instagram for the first drop."
    },
    {
      "type": "text",
      "id": "empty_cta_label",
      "label": "Empty button label",
      "default": "Follow the drop"
    },
    {
      "type": "url",
      "id": "empty_cta_link",
      "label": "Empty button link"
    },
    {
      "type": "header",
      "content": "View all"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "info": "Leave blank for the brand blush mix."
    }
  ],
  "presets": [
    {
      "name": "CM Shop"
    }
  ]
}
{% endschema %}
