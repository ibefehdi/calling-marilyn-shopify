{% liquid
  assign heading = section.settings.heading
  assign intro = section.settings.intro
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign view_more_label = section.settings.view_more_label
  assign view_more_link = section.settings.view_more_link
  if view_more_link == blank
    assign view_more_link = pages.locations.url | default: '/pages/locations'
  endif
%}

<section class="cm-find" aria-labelledby="cm-find-heading-{{ section.id }}">
  <div class="cm-find__copy">
    {% if heading != blank %}
      <h2 class="cm-find__heading" id="cm-find-heading-{{ section.id }}">{{ heading }}</h2>
    {% endif %}
    {% if intro != blank %}
      <p class="cm-find__intro">{{ intro }}</p>
    {% endif %}
    <div class="cm-find__actions">
      {% if view_more_label != blank %}
        <a class="cm-find__cta cm-find__cta--primary" href="{{ view_more_link }}">
          {{ view_more_label }}
        </a>
      {% endif %}
      {% if cta_label != blank %}
        <a
          class="cm-find__cta"
          href="{{ cta_link | default: 'https://www.instagram.com/callingmarilyn/' }}"
          {% if section.settings.cta_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
        >
          {{ cta_label }}
        </a>
      {% endif %}
    </div>
  </div>

  <div class="cm-find__list-wrap">
    <ul class="cm-find__list" role="list">
      {% for block in section.blocks %}
        <li class="cm-find__item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a class="cm-find__link" href="{{ block.settings.link }}">
              <span class="cm-find__place">{{ block.settings.place }}</span>
              {% if block.settings.detail != blank %}
                <span class="cm-find__detail">{{ block.settings.detail }}</span>
              {% endif %}
            </a>
          {% else %}
            <div class="cm-find__link cm-find__link--static">
              <span class="cm-find__place">{{ block.settings.place }}</span>
              {% if block.settings.detail != blank %}
                <span class="cm-find__detail">{{ block.settings.detail }}</span>
              {% endif %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>

    {% if view_more_label != blank %}
      <a class="cm-find__view-more" href="{{ view_more_link }}">
        <span>{{ view_more_label }}</span>
        <span class="cm-find__view-more-arrow" aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cm-find {
    display: grid;
    gap: 2.5rem;
    width: min(100% - 2.5rem, 70rem);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
  }

  .cm-find__copy {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }

  .cm-find__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 0.95;
    color: var(--cm-ink);
  }

  .cm-find__intro {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--cm-ink) 78%, transparent);
  }

  .cm-find__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.35rem;
  }

  .cm-find__cta {
    justify-self: start;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--cm-burgundy);
    background: transparent;
    color: var(--cm-burgundy);
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 180ms ease, color 180ms ease;
  }

  .cm-find__cta--primary {
    background: var(--cm-burgundy);
    color: var(--cm-cream);
    border-color: var(--cm-burgundy);
  }

  .cm-find__cta:hover {
    background: var(--cm-burgundy);
    color: var(--cm-cream);
  }

  .cm-find__cta--primary:hover {
    background: var(--cm-red);
    border-color: var(--cm-red);
  }

  .cm-find__cta:focus-visible {
    outline: 3px solid var(--cm-red);
    outline-offset: 3px;
  }

  .cm-find__list-wrap {
    display: grid;
    gap: 0.75rem;
  }

  .cm-find__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--cm-taupe);
  }

  .cm-find__item {
    border-bottom: 1px solid var(--cm-taupe);
  }

  .cm-find__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.15rem;
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease, padding-inline-start 160ms ease;
  }

  .cm-find__link:not(.cm-find__link--static):hover {
    color: var(--cm-red);
    padding-inline-start: 0.5rem;
  }

  .cm-find__link:focus-visible {
    outline: 3px solid var(--cm-red);
    outline-offset: 2px;
  }

  .cm-find__place {
    font-family: var(--font-heading--family);
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    line-height: 1.1;
  }

  .cm-find__detail {
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cm-ink) 55%, transparent);
  }

  .cm-find__view-more {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding-block: 0.5rem;
    color: var(--cm-burgundy);
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 160ms ease, gap 160ms ease;
  }

  .cm-find__view-more:hover {
    color: var(--cm-red);
    gap: 0.85rem;
  }

  .cm-find__view-more:focus-visible {
    outline: 3px solid var(--cm-red);
    outline-offset: 3px;
  }

  .cm-find__view-more-arrow {
    font-size: 1rem;
    line-height: 1;
  }

  @media screen and (min-width: 900px) {
    .cm-find {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: end;
      gap: 4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CM Find us",
  "tag": "section",
  "class": "section-cm-find",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where next?"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Catch the Photobooth Bus around Kuwait — malls, pop-ups, and private nights."
    },
    {
      "type": "header",
      "content": "View more"
    },
    {
      "type": "text",
      "id": "view_more_label",
      "label": "View more label",
      "default": "View more"
    },
    {
      "type": "url",
      "id": "view_more_link",
      "label": "View more link",
      "info": "Create a page using the Locations template, then select it here."
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Follow for drop pins"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "cta_new_tab",
      "label": "Open link in new tab",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "place",
      "name": "Place",
      "settings": [
        {
          "type": "text",
          "id": "place",
          "label": "Place",
          "default": "Marina Mall"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "default": "Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CM Find us",
      "blocks": [
        { "type": "place", "settings": { "place": "Marina Mall", "detail": "Now" } },
        { "type": "place", "settings": { "place": "360 Mall", "detail": "Kuwait" } },
        { "type": "place", "settings": { "place": "Assima Mall", "detail": "Kuwait" } },
        { "type": "place", "settings": { "place": "Private events", "detail": "Book" } }
      ]
    }
  ]
}
{% endschema %}
