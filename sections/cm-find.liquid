{% liquid
  assign heading = section.settings.heading
  assign intro = section.settings.intro
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign view_more_label = section.settings.view_more_label
  assign view_more_link = section.settings.view_more_link
  assign social_url = settings.social_instagram_url

  if view_more_link == blank
    assign view_more_link = pages.locations.url | default: '/pages/locations'
  endif

  if cta_link == blank
    assign cta_link = social_url
  endif

  assign bg = section.settings.background_color
%}

{% if bg != blank %}
  {% style %}
    #shopify-section-{{ section.id }} {
      background-color: {{ bg }};
    }
  {% endstyle %}
{% endif %}

<section
  class="cm-find"
  aria-labelledby="cm-find-heading-{{ section.id }}"
  style="
    --cm-find-pad-top: {{ section.settings.padding_top }}px;
    --cm-find-pad-bottom: {{ section.settings.padding_bottom }}px;
    --cm-find-max: {{ section.settings.content_width }}rem;
  "
>
  <div class="cm-find__copy">
    {% if heading != blank %}
      <h2 class="cm-find__heading" id="cm-find-heading-{{ section.id }}">{{ heading }}</h2>
    {% else %}
      <h2 class="visually-hidden" id="cm-find-heading-{{ section.id }}">Find us</h2>
    {% endif %}
    {% if intro != blank %}
      <p class="cm-find__intro">{{ intro }}</p>
    {% endif %}
    {% if view_more_label != blank or cta_label != blank %}
      <div class="cm-find__actions">
        {% if view_more_label != blank %}
          <a class="cm-find__cta cm-find__cta--primary" href="{{ view_more_link }}">
            {{ view_more_label }}
          </a>
        {% endif %}
        {% if cta_label != blank and cta_link != blank %}
          <a
            class="cm-find__cta"
            href="{{ cta_link }}"
            {% if section.settings.cta_new_tab %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            {{ cta_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="cm-find__list-wrap">
    <ul class="cm-find__list" role="list">
      {% for block in section.blocks %}
        <li class="cm-find__item" {{ block.shopify_attributes }}>
          {% liquid
            assign stop_num = forloop.index
            if forloop.index < 10
              assign stop_num = forloop.index | prepend: '0'
            endif
            assign status_chip = block.settings.detail
            assign place_new_tab = block.settings.open_in_new_tab
          %}
          {% if block.settings.link != blank %}
            <a
              class="cm-find__link"
              href="{{ block.settings.link }}"
              {% if place_new_tab %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
              <span class="cm-find__stop" aria-hidden="true">{{ stop_num }}</span>
              <span class="cm-find__place">{{ block.settings.place }}</span>
              {% if status_chip != blank %}
                <span class="cm-find__detail">{{ status_chip }}</span>
              {% endif %}
            </a>
          {% else %}
            <div class="cm-find__link cm-find__link--static">
              <span class="cm-find__stop" aria-hidden="true">{{ stop_num }}</span>
              <span class="cm-find__place">{{ block.settings.place }}</span>
              {% if status_chip != blank %}
                <span class="cm-find__detail">{{ status_chip }}</span>
              {% endif %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>

    {% if section.settings.show_list_view_more and view_more_label != blank %}
      <a class="cm-find__view-more" href="{{ view_more_link }}">
        <span>{{ view_more_label }}</span>
        <span class="cm-find__view-more-arrow" aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cm-find {
    display: grid;
    gap: 2.5rem;
    width: min(100% - 2.5rem, var(--cm-find-max, 70rem));
    margin-inline: auto;
    padding-block: var(--cm-find-pad-top, clamp(3.5rem, 9vw, 6.5rem))
      var(--cm-find-pad-bottom, clamp(3.5rem, 9vw, 6.5rem));
  }

  .cm-find__copy {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }

  .cm-find__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 0.95;
    color: var(--cm-ink);
  }

  .cm-find__intro {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--cm-ink) 78%, transparent);
  }

  .cm-find__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.35rem;
  }

  .cm-find__cta {
    justify-self: start;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--cm-gold-deep);
    background: transparent;
    color: var(--cm-burgundy);
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .cm-find__cta--primary {
    background: var(--cm-burgundy);
    color: var(--cm-on-red);
    border-color: var(--cm-on-red);
  }

  .cm-find__cta:hover {
    background: var(--cm-burgundy);
    color: var(--cm-on-red);
  }

  .cm-find__cta--primary:hover {
    background: var(--cm-red);
    border-color: var(--cm-on-red);
    color: var(--cm-on-red);
  }

  .cm-find__cta:focus-visible {
    outline: 3px solid var(--cm-red);
    outline-offset: 3px;
  }

  .cm-find__list-wrap {
    display: grid;
    gap: 0.75rem;
  }

  .cm-find__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .cm-find__item {
    border: none;
  }

  .cm-find__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.85rem 1rem;
    align-items: center;
    padding: 1rem 1.1rem;
    color: inherit;
    text-decoration: none;
    background: var(--cm-cream);
    border: 1px solid color-mix(in srgb, var(--cm-gold) 55%, var(--cm-taupe));
    border-inline-start: 3px solid var(--cm-burgundy);
    background-image: radial-gradient(
      circle at left center,
      transparent 4px,
      var(--cm-cream) 5px
    );
    background-size: 12px 100%;
    background-repeat: no-repeat;
    background-position: left center;
    transition: color 160ms ease, transform 160ms ease, border-color 160ms ease;
  }

  .cm-find__link:not(.cm-find__link--static):hover {
    color: var(--cm-red);
    transform: translateX(4px);
    border-color: var(--cm-gold);
  }

  .cm-find__link:focus-visible {
    outline: 3px solid var(--cm-red);
    outline-offset: 2px;
  }

  .cm-find__stop {
    font-family: var(--font-subheading--family);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--cm-gold-deep);
  }

  .cm-find__place {
    font-family: var(--font-heading--family);
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    line-height: 1.1;
  }

  .cm-find__detail {
    font-family: var(--font-subheading--family);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cm-on-red);
    background: var(--cm-burgundy);
    border: 1px solid var(--cm-on-red);
    padding: 0.35rem 0.55rem;
    white-space: nowrap;
  }

  .cm-find__view-more {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding-block: 0.5rem;
    color: var(--cm-burgundy);
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 160ms ease, gap 160ms ease;
  }

  .cm-find__view-more:hover {
    color: var(--cm-red);
    gap: 0.85rem;
  }

  .cm-find__view-more:focus-visible {
    outline: 3px solid var(--cm-red);
    outline-offset: 3px;
  }

  .cm-find__view-more-arrow {
    font-size: 1rem;
    line-height: 1;
  }

  @media screen and (min-width: 900px) {
    .cm-find {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: end;
      gap: 4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CM Find us",
  "tag": "section",
  "class": "section-cm-find",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where next?"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Catch the Photobooth Bus around Kuwait — malls, pop-ups, and private nights."
    },
    {
      "type": "header",
      "content": "View more"
    },
    {
      "type": "text",
      "id": "view_more_label",
      "label": "View more label",
      "default": "View more"
    },
    {
      "type": "url",
      "id": "view_more_link",
      "label": "View more link",
      "info": "Create a page using the Locations template, then select it here."
    },
    {
      "type": "checkbox",
      "id": "show_list_view_more",
      "label": "Show link under list",
      "default": true
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Follow for drop pins"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Defaults to Theme settings → Brand accents → Instagram URL when blank."
    },
    {
      "type": "checkbox",
      "id": "cta_new_tab",
      "label": "Open link in new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 40,
      "max": 90,
      "step": 2,
      "unit": "rem",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "info": "Leave blank for transparent (page cream)."
    }
  ],
  "blocks": [
    {
      "type": "place",
      "name": "Place",
      "settings": [
        {
          "type": "text",
          "id": "place",
          "label": "Place",
          "default": "Marina Mall"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail / status",
          "default": "Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CM Find us",
      "blocks": [
        { "type": "place", "settings": { "place": "Marina Mall", "detail": "Now" } },
        { "type": "place", "settings": { "place": "360 Mall", "detail": "Kuwait" } },
        { "type": "place", "settings": { "place": "Assima Mall", "detail": "Kuwait" } },
        { "type": "place", "settings": { "place": "Private events", "detail": "Book" } }
      ]
    }
  ]
}
{% endschema %}
