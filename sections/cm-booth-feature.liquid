{% liquid
  assign heading = section.settings.heading | default: 'Find a booth near you.'
  assign region_label = section.settings.region_label
  assign bg = section.settings.background_color
  assign stop_blocks = section.blocks | where: 'type', 'stop'
%}

<section
  class="cm-booth-feature"
  aria-labelledby="cm-booth-feature-heading-{{ section.id }}"
  style="
    --cm-booth-pad-top: {{ section.settings.padding_top }}px;
    --cm-booth-pad-bottom: {{ section.settings.padding_bottom }}px;
    {% if bg != blank %}--cm-booth-bg: {{ bg }};{% endif %}
  "
>
  <div class="cm-booth-feature__inner">
    {% if heading != blank %}
      <h2 class="cm-booth-feature__heading" id="cm-booth-feature-heading-{{ section.id }}">{{ heading }}</h2>
    {% else %}
      <h2 class="visually-hidden" id="cm-booth-feature-heading-{{ section.id }}">Find a booth</h2>
    {% endif %}

    {% if region_label != blank %}
      <p class="cm-booth-feature__region">
        <span class="cm-booth-feature__region-label">{{ region_label }}</span>
      </p>
    {% endif %}

    {% if stop_blocks.size > 0 %}
      <ul class="cm-booth-feature__list" role="list">
        {% for block in stop_blocks %}
          {% liquid
            assign place = block.settings.place
            assign detail = block.settings.detail
            assign link = block.settings.link
            assign link_label = block.settings.link_label | default: 'Get directions'
            assign image_alt = place | default: 'Booth location'
          %}
          <li class="cm-booth-feature__card" {{ block.shopify_attributes }}>
            <div class="cm-booth-feature__media">
              {% if block.settings.image != blank %}
                {% liquid
                  assign image_alt = block.settings.image.alt | default: image_alt
                %}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    class: 'cm-booth-feature__img',
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 28vw, 100vw',
                    widths: '400, 600, 900',
                    alt: image_alt
                }}
              {% elsif section.settings.use_fallback_image %}
                <img
                  class="cm-booth-feature__img"
                  src="{{ 'cm-memory-left.jpg' | asset_url }}"
                  alt="{{ image_alt | escape }}"
                  width="1650"
                  height="2200"
                  loading="lazy"
                >
              {% else %}
                <div class="cm-booth-feature__img-empty" role="img" aria-label="{{ image_alt | escape }}"></div>
              {% endif %}
            </div>

            <div class="cm-booth-feature__copy">
              {% if detail != blank %}
                <p class="cm-booth-feature__detail">{{ detail }}</p>
              {% endif %}
              {% if place != blank %}
                <h3 class="cm-booth-feature__place">{{ place }}</h3>
              {% endif %}
              {% if link != blank and link_label != blank %}
                <a
                  class="cm-booth-feature__link"
                  href="{{ link }}"
                  {% if block.settings.open_in_new_tab %}
                    target="_blank"
                    rel="noopener noreferrer"
                  {% endif %}
                >
                  <span>{{ link_label }}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cm-booth-feature {
    --cm-booth-bg: var(--cm-cream);
    background: var(--cm-booth-bg);
    color: var(--cm-ink);
    padding-block: var(--cm-booth-pad-top, 3.5rem) var(--cm-booth-pad-bottom, 4rem);
  }

  .cm-booth-feature__inner {
    display: grid;
    gap: 1.25rem;
    width: min(100% - 2.5rem, 72rem);
    margin-inline: auto;
  }

  .cm-booth-feature__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .cm-booth-feature__region {
    margin: 0;
  }

  .cm-booth-feature__region-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 10rem;
    padding: 0.7rem 1rem;
    border: 1px solid color-mix(in srgb, var(--cm-ink) 18%, transparent);
    background: var(--cm-cream);
    font-size: 0.95rem;
  }

  .cm-booth-feature__region-label::after {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border-inline-end: 1.5px solid currentColor;
    border-block-end: 1.5px solid currentColor;
    rotate: 45deg;
    translate: 0 -0.1rem;
    opacity: 0.7;
  }

  .cm-booth-feature__list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .cm-booth-feature__card {
    display: grid;
    gap: 1rem;
    padding: 0.85rem;
    border: 1px solid color-mix(in srgb, var(--cm-ink) 14%, transparent);
    background: color-mix(in srgb, var(--cm-cream) 92%, var(--cm-blush));
  }

  .cm-booth-feature__media {
    overflow: hidden;
    aspect-ratio: 16 / 11;
    background: color-mix(in srgb, var(--cm-blush) 30%, var(--cm-cream));
  }

  .cm-booth-feature__img,
  .cm-booth-feature__img-empty {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
  }

  .cm-booth-feature__img-empty {
    background: linear-gradient(145deg, var(--cm-cream), var(--cm-taupe));
  }

  .cm-booth-feature__copy {
    display: grid;
    gap: 0.35rem;
    align-content: center;
    padding-inline: 0.25rem 0.5rem;
    padding-block-end: 0.35rem;
  }

  .cm-booth-feature__detail {
    margin: 0;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--cm-ink) 65%, transparent);
  }

  .cm-booth-feature__place {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .cm-booth-feature__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-block-start: 0.45rem;
    color: var(--cm-burgundy);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .cm-booth-feature__link:hover {
    text-decoration: underline;
  }

  .cm-booth-feature__link:focus-visible {
    outline: 3px solid var(--cm-burgundy);
    outline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .cm-booth-feature__card {
      grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr);
      align-items: stretch;
      gap: 1.35rem;
      padding: 1rem;
    }

    .cm-booth-feature__media {
      aspect-ratio: 5 / 4;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CM Booth feature",
  "tag": "section",
  "class": "section-cm-booth-feature",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find a booth near you."
    },
    {
      "type": "text",
      "id": "region_label",
      "label": "Region label",
      "default": "Kuwait"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "info": "Leave blank for cream."
    },
    {
      "type": "checkbox",
      "id": "use_fallback_image",
      "label": "Use Make a memory left image when stop image is empty",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "stop",
      "name": "Booth stop",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "default": "Murouj"
        },
        {
          "type": "text",
          "id": "place",
          "label": "Place name",
          "default": "Marilyn's Post Office"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Get directions"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CM Booth feature",
      "blocks": [
        {
          "type": "stop",
          "settings": {
            "detail": "Murouj",
            "place": "Marilyn's Post Office",
            "link_label": "Get directions"
          }
        }
      ]
    }
  ]
}
{% endschema %}
