{% liquid
  assign heading = section.settings.heading | default: 'Shop the magnets.'
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign coming_soon = section.settings.coming_soon
  assign coming_list = section.settings.coming_list
  assign scene_alt = section.settings.scene_alt | default: 'Vintage fridge with photo magnets'
  assign bg = section.settings.background_color
  assign magnet_blocks = section.blocks | where: 'type', 'magnet'
  assign magnets_product = all_products['moment-magnets']
  assign strip_product = all_products['test-product']
  if strip_product == blank
    assign strip_product = all_products['photo-strip']
  endif
  assign use_baked_scene = section.settings.use_baked_magnets

  if cta_link == blank
    if magnets_product != blank
      assign cta_link = magnets_product.url
    else
      assign cta_link = routes.all_products_collection_url
    endif
  endif

  assign fallback_magnets = 'cm-magnet-strip-harlequin.jpg,cm-magnet-strip-blue-diamonds.jpg,cm-magnet-strip-hearts.jpg,cm-magnet-strip-gold-stars.jpg' | split: ','
  assign fallback_borders = 'cm-magnet-marble.jpg,cm-magnet-harlequin.jpg,cm-magnet-hearts.jpg,cm-magnet-gold-stars.jpg' | split: ','
  assign default_left = '30,48,66,84' | split: ','
  assign default_top = '8,7,9,8' | split: ','
  assign default_rotate = '-3,2,-1,3' | split: ','

  assign strip_photos = blank
  if strip_product != blank and strip_product.images.size > 0
    assign strip_photos = strip_product.images
  endif
%}

<section
  class="cm-magnet-shop{% if use_baked_scene %} cm-magnet-shop--baked{% endif %}"
  aria-labelledby="cm-magnet-shop-heading-{{ section.id }}"
  style="
    --cm-magnet-pad-top: {{ section.settings.padding_top }}px;
    --cm-magnet-pad-bottom: {{ section.settings.padding_bottom }}px;
    {% if bg != blank %}--cm-magnet-bg: {{ bg }};{% endif %}
  "
>
  <div class="cm-magnet-shop__header">
    {% if heading != blank %}
      <h2 class="cm-magnet-shop__heading" id="cm-magnet-shop-heading-{{ section.id }}">{{ heading }}</h2>
    {% else %}
      <h2 class="visually-hidden" id="cm-magnet-shop-heading-{{ section.id }}">Shop the magnets</h2>
    {% endif %}
  </div>

  <div class="cm-magnet-shop__stage">
    <div class="cm-magnet-shop__scene">
      {% if section.settings.scene_image != blank %}
        {% liquid
          assign scene_alt = section.settings.scene_image.alt | default: scene_alt
        %}
        {{
          section.settings.scene_image
          | image_url: width: 2400
          | image_tag:
            class: 'cm-magnet-shop__scene-img',
            loading: 'lazy',
            sizes: '100vw',
            widths: '800, 1200, 1600, 2000, 2400',
            alt: scene_alt
        }}
      {% elsif use_baked_scene %}
        <img
          class="cm-magnet-shop__scene-img"
          src="{{ 'cm-fridge-door-hq.jpg' | asset_url }}"
          alt="{{ scene_alt | escape }}"
          width="3072"
          height="2048"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        >
      {% else %}
        <img
          class="cm-magnet-shop__scene-img"
          src="{{ 'cm-fridge-door-hq.jpg' | asset_url }}"
          alt="{{ scene_alt | escape }}"
          width="3072"
          height="2048"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        >
      {% endif %}

      {% unless use_baked_scene %}
        {% if magnet_blocks.size > 0 %}
          <ul class="cm-magnet-shop__magnets" role="list">
            {% for block in magnet_blocks %}
              {% liquid
                assign magnet_alt = block.settings.caption | default: 'Photo magnet'
                assign hq_magnet = fallback_magnets[forloop.index0]
                assign border_asset = fallback_borders[forloop.index0]
                assign magnet_link = block.settings.link
                if magnet_link == blank and magnets_product != blank
                  assign magnet_link = magnets_product.url
                endif

                assign border_image = block.settings.border_image
                assign use_composed = false
                if block.settings.image == blank and hq_magnet == blank
                  assign use_composed = true
                endif
                if block.settings.image == blank and block.settings.border_image != blank
                  assign use_composed = true
                endif
                if block.settings.image == blank and block.settings.photo_image != blank and hq_magnet == blank
                  assign use_composed = true
                endif

                assign pos_left = block.settings.offset_x
                assign pos_top = block.settings.offset_y
                assign pos_rotate = block.settings.rotate
                assign pos_width = block.settings.width
                if pos_left == blank
                  assign pos_left = default_left[forloop.index0] | default: 30
                endif
                if pos_top == blank
                  assign pos_top = default_top[forloop.index0] | default: 8
                endif
                if pos_rotate == blank
                  assign pos_rotate = default_rotate[forloop.index0] | default: 0
                endif
                if pos_width == blank
                  assign pos_width = 12
                endif

                assign photo_offset = forloop.index0
              %}
              <li
                class="cm-magnet-shop__magnet"
                style="
                  --cm-magnet-left: {{ pos_left }}%;
                  --cm-magnet-top: {{ pos_top }}%;
                  --cm-magnet-rotate: {{ pos_rotate }}deg;
                  --cm-magnet-width: {{ pos_width }}%;
                "
                {{ block.shopify_attributes }}
              >
                {% if magnet_link != blank %}
                  <a class="cm-magnet-shop__magnet-link" href="{{ magnet_link }}">
                {% endif %}
                <figure class="cm-magnet-shop__figure">
                  <div class="cm-magnet-shop__frame{% if use_composed %} cm-magnet-shop__frame--composed{% endif %}">
                    {% if block.settings.image != blank %}
                      {% liquid
                        assign magnet_alt = block.settings.image.alt | default: magnet_alt
                      %}
                      {{
                        block.settings.image
                        | image_url: width: 600
                        | image_tag:
                          class: 'cm-magnet-shop__img',
                          loading: 'lazy',
                          sizes: '(min-width: 750px) 12vw, 22vw',
                          widths: '240, 400, 600',
                          alt: magnet_alt
                      }}
                    {% elsif hq_magnet != blank and use_composed == false %}
                      <img
                        class="cm-magnet-shop__img"
                        src="{{ hq_magnet | asset_url }}"
                        alt="{{ magnet_alt | escape }}"
                        width="1200"
                        height="2800"
                        loading="lazy"
                        decoding="async"
                      >
                    {% else %}
                      <div class="cm-magnet-shop__photos" aria-hidden="true">
                        {% if strip_photos != blank %}
                          {% for i in (0..2) %}
                            {% liquid
                              assign photo_index = photo_offset | plus: i | modulo: strip_photos.size
                              assign photo = strip_photos[photo_index]
                            %}
                            {{
                              photo
                              | image_url: width: 400
                              | image_tag:
                                class: 'cm-magnet-shop__photo',
                                loading: 'lazy',
                                sizes: '(min-width: 750px) 10vw, 18vw',
                                widths: '160, 240, 400',
                                alt: ''
                            }}
                          {% endfor %}
                        {% elsif block.settings.photo_image != blank %}
                          {{
                            block.settings.photo_image
                            | image_url: width: 400
                            | image_tag:
                              class: 'cm-magnet-shop__photo cm-magnet-shop__photo--single',
                              loading: 'lazy',
                              sizes: '(min-width: 750px) 10vw, 18vw',
                              widths: '160, 240, 400',
                              alt: ''
                          }}
                        {% else %}
                          <div class="cm-magnet-shop__photo-empty"></div>
                          <div class="cm-magnet-shop__photo-empty"></div>
                          <div class="cm-magnet-shop__photo-empty"></div>
                        {% endif %}
                      </div>

                      {% if border_image != blank %}
                        {% liquid
                          assign magnet_alt = border_image.alt | default: magnet_alt
                        %}
                        {{
                          border_image
                          | image_url: width: 600
                          | image_tag:
                            class: 'cm-magnet-shop__border',
                            loading: 'lazy',
                            sizes: '(min-width: 750px) 12vw, 22vw',
                            widths: '240, 400, 600',
                            alt: magnet_alt
                        }}
                      {% elsif border_asset != blank %}
                        <img
                          class="cm-magnet-shop__border"
                          src="{{ border_asset | asset_url }}"
                          alt="{{ magnet_alt | escape }}"
                          width="342"
                          height="1024"
                          loading="lazy"
                        >
                      {% endif %}
                    {% endif %}
                  </div>
                  {% if block.settings.caption != blank %}
                    <figcaption class="cm-magnet-shop__caption">{{ block.settings.caption }}</figcaption>
                  {% endif %}
                </figure>
                {% if magnet_link != blank %}
                  </a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      {% endunless %}
    </div>
  </div>

  {% if cta_label != blank or coming_soon != blank or coming_list != blank %}
    <div class="cm-magnet-shop__footer">
      {% if cta_label != blank %}
        <a
          class="cm-magnet-shop__cta"
          href="{{ cta_link }}"
          {% if section.settings.cta_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
        >
          {{ cta_label }}
        </a>
      {% endif %}
      {% if coming_soon != blank %}
        <p class="cm-magnet-shop__coming">{{ coming_soon }}</p>
      {% endif %}
      {% if coming_list != blank %}
        <p class="cm-magnet-shop__coming-list">{{ coming_list }}</p>
      {% endif %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .cm-magnet-shop {
    --cm-magnet-bg: #c4e2c8;
    background: var(--cm-magnet-bg);
    color: var(--cm-ink);
    padding-block: var(--cm-magnet-pad-top, 3.5rem) var(--cm-magnet-pad-bottom, 3.5rem);
    display: grid;
    gap: clamp(1.1rem, 2.5vw, 1.6rem);
    position: relative;
    z-index: 1;
    overflow: visible;
  }

  .cm-magnet-shop__header {
    width: min(100% - 2.5rem, 48rem);
    margin-inline: auto;
    position: relative;
    z-index: 2;
  }

  .cm-magnet-shop__heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: clamp(2.35rem, 8vw, 3.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: left;
    text-wrap: balance;
  }

  .cm-magnet-shop__stage {
    position: relative;
    isolation: isolate;
    width: 100%;
    margin: 0;
  }

  .cm-magnet-shop__scene {
    position: relative;
    overflow: visible;
    border-radius: 0;
    background: #c4e2c8;
    box-shadow: none;
  }

  .cm-magnet-shop__scene-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: left center;
    image-rendering: auto;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .cm-magnet-shop__magnets {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .cm-magnet-shop__magnet {
    position: absolute;
    left: var(--cm-magnet-left, 30%);
    top: var(--cm-magnet-top, 8%);
    width: var(--cm-magnet-width, 12%);
    transform: translate3d(-50%, 0, 0) rotate(var(--cm-magnet-rotate, 0deg));
    transform-origin: center top;
    pointer-events: auto;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .cm-magnet-shop__magnet-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .cm-magnet-shop__magnet-link:focus-visible {
    outline: 3px solid var(--cm-ink);
    outline-offset: 3px;
  }

  .cm-magnet-shop__figure {
    margin: 0;
    display: grid;
    gap: 0.35rem;
    justify-items: center;
  }

  .cm-magnet-shop__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 5;
    border-radius: 0.45rem;
    overflow: hidden;
    background: transparent;
    box-shadow:
      0 0.2rem 0.45rem color-mix(in srgb, var(--cm-ink) 22%, transparent);
  }

  .cm-magnet-shop__frame--composed {
    background: #111;
  }

  .cm-magnet-shop__photos {
    position: absolute;
    /* Tuned to the Moment Magnets / cm-magnet-* black cutout */
    inset: 6.8% 11% 9% 11%;
    z-index: 2;
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 1.6%;
    overflow: hidden;
    background: #0a0a0a;
    border-radius: 0.12rem;
  }

  .cm-magnet-shop__photo,
  .cm-magnet-shop__photo-empty {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: center;
  }

  .cm-magnet-shop__photo:nth-child(1) {
    object-position: center 20%;
  }

  .cm-magnet-shop__photo:nth-child(2) {
    object-position: center 45%;
  }

  .cm-magnet-shop__photo:nth-child(3) {
    object-position: center 70%;
  }

  .cm-magnet-shop__photo--single {
    grid-row: 1 / -1;
  }

  .cm-magnet-shop__photo-empty {
    background: linear-gradient(160deg, #2a2a2a, #111);
  }

  .cm-magnet-shop__border {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
  }

  .cm-magnet-shop__img,
  .cm-magnet-shop__img-empty {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    image-rendering: auto;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .cm-magnet-shop__img-empty {
    background: linear-gradient(160deg, var(--cm-cream), var(--cm-taupe));
  }

  .cm-magnet-shop__caption {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: clamp(0.62rem, 1.5vw, 0.8rem);
    line-height: 1.2;
    text-align: center;
    color: var(--cm-ink);
  }

  .cm-magnet-shop__footer {
    display: grid;
    gap: 0.55rem;
    justify-items: center;
    text-align: center;
    width: min(100% - 2.5rem, 48rem);
    margin-inline: auto;
    margin-block-start: 0.15rem;
    position: relative;
    z-index: 2;
  }

  .cm-magnet-shop__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 24rem);
    padding: 1.1rem 1.6rem;
    border-radius: 0.7rem;
    background: #1a1a1a;
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .cm-magnet-shop__cta:hover {
    background: #000;
    color: #fff;
  }

  .cm-magnet-shop__cta:focus-visible {
    outline: 3px solid var(--cm-ink);
    outline-offset: 3px;
  }

  .cm-magnet-shop__coming {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--cm-ink) 82%, transparent);
  }

  .cm-magnet-shop__coming-list {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.85rem;
    color: #8a3a45;
  }

  @media screen and (max-width: 549px) {
    .cm-magnet-shop__magnets {
      position: static;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.5rem;
      margin-block-start: 1rem;
      padding-inline: 1rem;
      pointer-events: auto;
    }

    .cm-magnet-shop__magnet {
      position: static;
      left: auto;
      top: auto;
      width: 100%;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CM Magnet shop",
  "tag": "section",
  "class": "section-cm-magnet-shop",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the magnets."
    },
    {
      "type": "image_picker",
      "id": "scene_image",
      "label": "Fridge / scene image",
      "info": "Leave blank for the HQ pink fridge asset from the product shoot."
    },
    {
      "type": "text",
      "id": "scene_alt",
      "label": "Scene alt text",
      "default": "Retro fridge with photo magnets"
    },
    {
      "type": "checkbox",
      "id": "use_baked_magnets",
      "label": "Hide magnet overlays (fridge image only)",
      "default": true,
      "info": "On by default — the fridge photo already includes the magnets."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop magnets."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Defaults to the Moment Magnets product when blank."
    },
    {
      "type": "checkbox",
      "id": "cta_new_tab",
      "label": "Open button in new tab",
      "default": false
    },
    {
      "type": "text",
      "id": "coming_soon",
      "label": "Coming soon line",
      "default": "More keepsakes coming soon."
    },
    {
      "type": "text",
      "id": "coming_list",
      "label": "Coming soon list",
      "default": "Bookmarks · Phone cases · Stickers"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#c4e2c8"
    }
  ],
  "blocks": [
    {
      "type": "magnet",
      "name": "Magnet",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Full magnet image",
          "info": "Optional override. Leave blank to use the high-quality magnet strip assets."
        },
        {
          "type": "image_picker",
          "id": "border_image",
          "label": "Border frame",
          "info": "Only used if composing a custom magnet (with Inner photo). Otherwise HQ strip assets are used."
        },
        {
          "type": "image_picker",
          "id": "photo_image",
          "label": "Inner photo",
          "info": "Only used with Border frame for a custom composed magnet."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Black & white"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to Moment Magnets product."
        },
        {
          "type": "header",
          "content": "Position on fridge"
        },
        {
          "type": "range",
          "id": "offset_x",
          "label": "Horizontal position",
          "min": 10,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 30,
          "info": "Percent from the left edge of the fridge."
        },
        {
          "type": "range",
          "id": "offset_y",
          "label": "Vertical position",
          "min": 0,
          "max": 70,
          "step": 1,
          "unit": "%",
          "default": 8,
          "info": "Percent from the top of the fridge."
        },
        {
          "type": "range",
          "id": "width",
          "label": "Width",
          "min": 8,
          "max": 22,
          "step": 1,
          "unit": "%",
          "default": 12
        },
        {
          "type": "range",
          "id": "rotate",
          "label": "Rotation",
          "min": -15,
          "max": 15,
          "step": 1,
          "unit": "deg",
          "default": -2
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CM Magnet shop",
      "blocks": [
        {
          "type": "magnet",
          "settings": {
            "caption": "Harlequin",
            "offset_x": 30,
            "offset_y": 8,
            "width": 12,
            "rotate": -3
          }
        },
        {
          "type": "magnet",
          "settings": {
            "caption": "Blue diamonds",
            "offset_x": 48,
            "offset_y": 7,
            "width": 12,
            "rotate": 2
          }
        },
        {
          "type": "magnet",
          "settings": {
            "caption": "Hearts",
            "offset_x": 66,
            "offset_y": 9,
            "width": 12,
            "rotate": -1
          }
        },
        {
          "type": "magnet",
          "settings": {
            "caption": "Golden stars",
            "offset_x": 84,
            "offset_y": 8,
            "width": 12,
            "rotate": 3
          }
        }
      ]
    }
  ]
}
{% endschema %}
