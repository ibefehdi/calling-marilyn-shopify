{% liquid
  assign brand_name = section.settings.brand_name | default: shop.name
  assign eyebrow = section.settings.eyebrow
  assign tagline = section.settings.tagline
  assign primary_label = section.settings.primary_label
  assign primary_link = section.settings.primary_link
  assign secondary_label = section.settings.secondary_label
  assign secondary_link = section.settings.secondary_link
  assign explore_menu = section.settings.explore_menu
  assign book_menu = section.settings.book_menu
  assign explore_heading = section.settings.explore_heading
  assign book_heading = section.settings.book_heading
  assign show_newsletter = section.settings.show_newsletter
  assign newsletter_label = section.settings.newsletter_label
  assign newsletter_button = section.settings.newsletter_button
  assign status_line = section.settings.status_line
  assign show_policies = section.settings.show_policies
  assign logo_height = section.settings.logo_height | default: 72

  if primary_link == blank
    assign primary_link = settings.social_instagram_url
  endif

  if secondary_link == blank
    assign secondary_link = pages.locations.url | default: '/pages/locations'
  endif

  assign form_id = 'cm-footer-newsletter-' | append: section.id
  assign ribbon_blocks = section.blocks | where: 'type', 'ribbon_item'
  assign newsletter_placeholder = section.settings.newsletter_placeholder | default: 'Email address'
  assign newsletter_success = section.settings.newsletter_success | default: "You're on the list. See you at the next drop."
  assign email_label = section.settings.newsletter_email_label | default: 'Email address'
  assign show_ribbon = section.settings.show_ribbon
  assign bg = section.settings.background_color
%}

<footer
  class="cm-footer"
  role="contentinfo"
  aria-labelledby="cm-footer-brand-{{ section.id }}"
  style="{% if bg != blank %}--cm-footer-bg: {{ bg }};{% endif %}"
>
  {% if show_ribbon %}
    <div class="cm-footer__ribbon" aria-hidden="true">
      <div class="cm-footer__ribbon-track">
        {% for copy_index in (1..2) %}
          <div class="cm-footer__ribbon-group"{% if copy_index == 2 %} aria-hidden="true"{% endif %}>
            {% for block in ribbon_blocks %}
              {% if block.settings.text != blank %}
                <span
                  class="cm-footer__ribbon-item"
                  {% if copy_index == 1 %}
                    {{ block.shopify_attributes }}
                  {% endif %}
                >
                  {{- block.settings.text -}}
                </span>
                <span class="cm-footer__ribbon-dot">{{ section.settings.ribbon_separator | default: '●' }}</span>
              {% endif %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="cm-footer__main">
    <div class="cm-footer__brand">
      {% if eyebrow != blank %}
        <p class="cm-footer__eyebrow">{{ eyebrow }}</p>
      {% endif %}

      <div class="cm-footer__logo" id="cm-footer-brand-{{ section.id }}">
        {% if settings.logo != blank %}
          {{
            settings.logo
            | image_url: height: logo_height
            | image_tag:
              class: 'cm-footer__logo-img',
              alt: brand_name,
              loading: 'lazy',
              heights: logo_height
          }}
        {% else %}
          {% render 'cm-logo',
            class: 'cm-footer__logo-img',
            height: logo_height,
            alt: brand_name
          %}
        {% endif %}
      </div>

      {% if tagline != blank %}
        <p class="cm-footer__tagline">{{ tagline }}</p>
      {% endif %}

      <div class="cm-footer__actions">
        {% if primary_label != blank and primary_link != blank %}
          <a
            class="cm-footer__cta cm-footer__cta--primary"
            href="{{ primary_link }}"
            {% if section.settings.primary_new_tab %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            {{ primary_label }}
          </a>
        {% endif %}

        {% if secondary_label != blank and secondary_link != blank %}
          <a class="cm-footer__cta" href="{{ secondary_link }}">
            {{ secondary_label }}
          </a>
        {% endif %}
      </div>

      {% if show_newsletter %}
        <div class="cm-footer__newsletter">
          {% if newsletter_label != blank %}
            <p class="cm-footer__newsletter-label" id="cm-footer-newsletter-label-{{ section.id }}">
              {{ newsletter_label }}
            </p>
          {% endif %}

          {% form 'customer', id: form_id, class: 'cm-footer__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            <div class="cm-footer__form-row">
              <label class="visually-hidden" for="cm-footer-email-{{ section.id }}">{{ email_label }}</label>
              <input
                id="cm-footer-email-{{ section.id }}"
                class="cm-footer__input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="{{ newsletter_placeholder | escape }}"
                required
                aria-required="true"
                {% if newsletter_label != blank %}
                  aria-describedby="cm-footer-newsletter-label-{{ section.id }}"
                {% endif %}
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="cm-footer-newsletter-error-{{ section.id }}"
                {% endif %}
              >
              <button class="cm-footer__submit" type="submit">
                {{ newsletter_button | default: 'Sign up' }}
              </button>
            </div>

            {% if form.errors %}
              <p
                class="cm-footer__form-message cm-footer__form-message--error"
                id="cm-footer-newsletter-error-{{ section.id }}"
                role="alert"
              >
                {{ form.errors.messages.email }}
              </p>
            {% endif %}

            {% if form.posted_successfully? %}
              <p
                class="cm-footer__form-message cm-footer__form-message--success"
                role="status"
                tabindex="-1"
                id="cm-footer-newsletter-success-{{ section.id }}"
              >
                {{ newsletter_success }}
              </p>
              <script>
                requestAnimationFrame(() => {
                  document.getElementById('cm-footer-newsletter-success-{{ section.id }}')?.focus();
                });
              </script>
            {% endif %}
          {% endform %}
        </div>
      {% endif %}
    </div>

    {% if explore_menu != blank and explore_menu.links.size > 0 %}
      <nav class="cm-footer__nav" aria-labelledby="cm-footer-explore-{{ section.id }}">
        {% if explore_heading != blank %}
          <p class="cm-footer__nav-heading" id="cm-footer-explore-{{ section.id }}">{{ explore_heading }}</p>
        {% else %}
          <p class="visually-hidden" id="cm-footer-explore-{{ section.id }}">Explore</p>
        {% endif %}
        <ul class="cm-footer__links" role="list">
          {% for link in explore_menu.links %}
            <li>
              <a class="cm-footer__link" href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    {% if book_menu != blank and book_menu.links.size > 0 %}
      <nav class="cm-footer__nav" aria-labelledby="cm-footer-book-{{ section.id }}">
        {% if book_heading != blank %}
          <p class="cm-footer__nav-heading" id="cm-footer-book-{{ section.id }}">{{ book_heading }}</p>
        {% else %}
          <p class="visually-hidden" id="cm-footer-book-{{ section.id }}">Book</p>
        {% endif %}
        <ul class="cm-footer__links" role="list">
          {% for link in book_menu.links %}
            <li>
              <a class="cm-footer__link" href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
  </div>

  <div class="cm-footer__bar">
    <p class="cm-footer__copyright">
      &copy; {{ 'now' | date: '%Y' }}
      {{ brand_name }}
    </p>

    {% if status_line != blank %}
      <p class="cm-footer__status">{{ status_line }}</p>
    {% endif %}

    {% if show_policies and shop.policies.size > 0 %}
      <ul class="cm-footer__policies" role="list">
        {% for policy in shop.policies %}
          {% if policy != blank %}
            <li>
              <a class="cm-footer__policy" href="{{ policy.url }}">{{ policy.title }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .cm-footer {
    --cm-footer-bg: var(--cm-burgundy);
    --cm-footer-ink: var(--cm-on-red);
    --cm-footer-muted: color-mix(in srgb, var(--cm-on-red) 72%, transparent);
    background: var(--cm-footer-bg);
    color: var(--cm-footer-ink);
  }

  .cm-footer__ribbon {
    overflow: hidden;
    background: var(--cm-red);
    color: var(--cm-on-red);
    border-block-end: 1px solid color-mix(in srgb, var(--cm-ink) 25%, transparent);
  }

  .cm-footer__ribbon-track {
    display: flex;
    width: max-content;
    animation: cm-footer-ribbon 36s linear infinite;
  }

  .cm-footer__ribbon-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.7rem;
    padding-inline-end: 1.25rem;
    font-family: var(--font-subheading--family);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cm-footer__ribbon-dot {
    font-size: 0.4rem;
    opacity: 0.7;
  }

  @keyframes cm-footer-ribbon {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cm-footer__ribbon-track {
      animation: none;
    }
  }

  .cm-footer__main {
    display: grid;
    gap: 2.5rem;
    width: min(100% - 2.5rem, 72rem);
    margin-inline: auto;
    padding-block: clamp(2.75rem, 7vw, 4.5rem) clamp(2rem, 5vw, 3rem);
  }

  .cm-footer__brand {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }

  .cm-footer__eyebrow {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cm-on-red) 70%, transparent);
  }

  .cm-footer__logo {
    display: block;
    max-width: min(100%, 22rem);
  }

  .cm-footer__logo-img {
    display: block;
    width: auto;
    height: clamp(2.75rem, 8vw, 4.5rem);
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
    filter: none;
  }

  .cm-footer__tagline {
    margin: 0;
    max-width: 32ch;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--cm-footer-muted);
  }

  .cm-footer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.35rem;
  }

  .cm-footer__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--cm-on-red) 75%, transparent);
    background: transparent;
    color: var(--cm-on-red);
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .cm-footer__cta--primary {
    background: var(--cm-cream);
    color: var(--cm-burgundy);
    border-color: var(--cm-on-red);
  }

  .cm-footer__cta:hover {
    background: var(--cm-cream);
    color: var(--cm-burgundy);
    border-color: var(--cm-on-red);
  }

  .cm-footer__cta--primary:hover {
    background: var(--cm-red);
    color: var(--cm-on-red);
    border-color: var(--cm-on-red);
  }

  .cm-footer__cta:focus-visible {
    outline: 3px solid var(--cm-on-red);
    outline-offset: 3px;
  }

  .cm-footer__newsletter {
    display: grid;
    gap: 0.65rem;
    margin-block-start: 0.75rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid color-mix(in srgb, var(--cm-on-red) 22%, transparent);
  }

  .cm-footer__newsletter-label {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cm-on-red) 75%, transparent);
  }

  .cm-footer__form {
    display: grid;
    gap: 0.55rem;
  }

  .cm-footer__form-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
  }

  .cm-footer__input {
    min-width: 0;
    width: 100%;
    padding: 0.85rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--cm-on-red) 45%, transparent);
    background: color-mix(in srgb, var(--cm-ink) 18%, transparent);
    color: var(--cm-on-red);
    font-size: 0.95rem;
    line-height: 1.2;
  }

  .cm-footer__input::placeholder {
    color: color-mix(in srgb, var(--cm-on-red) 55%, transparent);
  }

  .cm-footer__input:focus-visible {
    outline: 3px solid var(--cm-on-red);
    outline-offset: 2px;
    border-color: var(--cm-on-red);
  }

  .cm-footer__submit {
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--cm-cream);
    background: var(--cm-cream);
    color: var(--cm-burgundy);
    font-family: var(--font-subheading--family);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .cm-footer__submit:hover {
    background: var(--cm-red);
    border-color: var(--cm-on-red);
    color: var(--cm-on-red);
  }

  .cm-footer__submit:focus-visible {
    outline: 3px solid var(--cm-on-red);
    outline-offset: 3px;
  }

  .cm-footer__form-message {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .cm-footer__form-message--error {
    color: #ffd4d4;
  }

  .cm-footer__form-message--success {
    color: var(--cm-cream);
  }

  .cm-footer__form-message--success:focus {
    outline: 3px solid var(--cm-on-red);
    outline-offset: 2px;
  }

  .cm-footer__nav {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .cm-footer__nav-heading {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cm-on-red) 68%, transparent);
  }

  .cm-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .cm-footer__link {
    color: var(--cm-on-red);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.3;
    transition: color 160ms ease, padding-inline-start 160ms ease;
  }

  .cm-footer__link:hover {
    color: color-mix(in srgb, var(--cm-on-red) 88%, var(--cm-cream));
    padding-inline-start: 0.35rem;
  }

  .cm-footer__link:focus-visible {
    outline: 3px solid var(--cm-on-red);
    outline-offset: 3px;
  }

  .cm-footer__bar {
    display: grid;
    gap: 0.85rem;
    width: min(100% - 2.5rem, 72rem);
    margin-inline: auto;
    padding-block: 1.15rem 1.5rem;
    border-block-start: 1px solid color-mix(in srgb, var(--cm-on-red) 18%, transparent);
    color: var(--cm-footer-muted);
    font-size: 0.75rem;
  }

  .cm-footer__copyright,
  .cm-footer__status {
    margin: 0;
    letter-spacing: 0.04em;
  }

  .cm-footer__status {
    font-family: var(--font-subheading--family);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cm-on-red) 78%, transparent);
  }

  .cm-footer__policies {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.15rem;
  }

  .cm-footer__policy {
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .cm-footer__policy:hover {
    color: var(--cm-on-red);
  }

  .cm-footer__policy:focus-visible {
    outline: 3px solid var(--cm-on-red);
    outline-offset: 3px;
  }

  @media screen and (max-width: 599px) {
    .cm-footer__form-row {
      grid-template-columns: 1fr;
    }

    .cm-footer__submit {
      width: 100%;
    }
  }

  @media screen and (min-width: 750px) {
    .cm-footer__main {
      grid-template-columns: minmax(0, 1.55fr) repeat(auto-fit, minmax(9rem, 0.5fr));
      gap: 2.5rem 3rem;
      align-items: start;
    }

    .cm-footer__bar {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 1.25rem;
    }

    .cm-footer__status {
      justify-self: center;
      text-align: center;
    }

    .cm-footer__policies {
      justify-content: end;
    }
  }

  @media (prefers-contrast: more) {
    .cm-footer__tagline,
    .cm-footer__eyebrow,
    .cm-footer__nav-heading,
    .cm-footer__newsletter-label,
    .cm-footer__copyright,
    .cm-footer__status {
      color: var(--cm-on-red);
    }

    .cm-footer__input {
      border-color: var(--cm-on-red);
      background: var(--cm-ink);
    }

    .cm-footer__cta,
    .cm-footer__submit {
      border-width: 2px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CM Footer",
  "tag": "div",
  "class": "section-cm-footer",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Photobooth Bus"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Calling Marilyn",
      "info": "Used for logo alt text and copyright."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "textarea",
