{% liquid
  assign heading = section.settings.heading | default: 'Make a memory.'
  assign left_alt = section.settings.left_alt | default: 'Photobooth'
  assign top_alt = section.settings.right_top_alt | default: 'Photo collage'
  assign bottom_alt = section.settings.right_bottom_alt | default: 'Photo keepsake'
  assign bg = section.settings.background_color
%}

<section
  class="cm-memory"
  aria-labelledby="cm-memory-heading-{{ section.id }}"
  style="
    --cm-memory-pad-top: {{ section.settings.padding_top }}px;
    --cm-memory-pad-bottom: {{ section.settings.padding_bottom }}px;
    {% if bg != blank %}--cm-memory-bg: {{ bg }};{% endif %}
  "
>
  <div class="cm-memory__inner">
    {% if heading != blank %}
      <h2 class="cm-memory__heading" id="cm-memory-heading-{{ section.id }}">{{ heading }}</h2>
    {% else %}
      <h2 class="visually-hidden" id="cm-memory-heading-{{ section.id }}">Make a memory</h2>
    {% endif %}

    <div class="cm-memory__grid">
      <figure class="cm-memory__frame cm-memory__frame--left">
        {% if section.settings.left_image != blank %}
          {% liquid
            assign left_alt = section.settings.left_image.alt | default: left_alt
          %}
          {{
            section.settings.left_image
            | image_url: width: 1600
            | image_tag:
              class: 'cm-memory__img',
              loading: 'lazy',
              sizes: '(min-width: 900px) 48vw, 100vw',
              widths: '600, 900, 1200, 1600',
              alt: left_alt
          }}
        {% elsif section.settings.use_fallback_images %}
          <img
            class="cm-memory__img"
            src="{{ 'cm-memory-left.jpg' | asset_url }}"
            alt="{{ left_alt | escape }}"
            width="1650"
            height="2200"
            loading="lazy"
          >
        {% else %}
          <div class="cm-memory__empty" role="img" aria-label="{{ left_alt | escape }}"></div>
        {% endif %}
      </figure>

      <div class="cm-memory__stack">
        <figure class="cm-memory__frame cm-memory__frame--top">
          {% if section.settings.right_top_image != blank %}
            {% liquid
              assign top_alt = section.settings.right_top_image.alt | default: top_alt
            %}
            {{
              section.settings.right_top_image
              | image_url: width: 1400
              | image_tag:
                class: 'cm-memory__img',
                loading: 'lazy',
                sizes: '(min-width: 900px) 44vw, 100vw',
                widths: '500, 800, 1200, 1400',
                alt: top_alt
            }}
          {% elsif section.settings.use_fallback_images %}
            <img
              class="cm-memory__img"
              src="{{ 'cm-memory-top.jpg' | asset_url }}"
              alt="{{ top_alt | escape }}"
              width="1500"
              height="2000"
              loading="lazy"
            >
          {% else %}
            <div class="cm-memory__empty" role="img" aria-label="{{ top_alt | escape }}"></div>
          {% endif %}
          {% if section.settings.tape_label != blank %}
            <span class="cm-memory__tape">{{ section.settings.tape_label }}</span>
          {% endif %}
        </figure>

        <figure class="cm-memory__frame cm-memory__frame--bottom">
          {% if section.settings.right_bottom_image != blank %}
            {% liquid
              assign bottom_alt = section.settings.right_bottom_image.alt | default: bottom_alt
            %}
            {{
              section.settings.right_bottom_image
              | image_url: width: 1400
              | image_tag:
                class: 'cm-memory__img',
                loading: 'lazy',
                sizes: '(min-width: 900px) 44vw, 100vw',
                widths: '500, 800, 1200, 1400',
                alt: bottom_alt
            }}
          {% elsif section.settings.use_fallback_images %}
            <img
              class="cm-memory__img"
              src="{{ 'cm-memory-bottom.jpg' | asset_url }}"
              alt="{{ bottom_alt | escape }}"
              width="1800"
              height="1350"
              loading="lazy"
            >
          {% else %}
            <div class="cm-memory__empty" role="img" aria-label="{{ bottom_alt | escape }}"></div>
          {% endif %}
        </figure>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .cm-memory {
    --cm-memory-bg: var(--cm-cream);
    background: var(--cm-memory-bg);
    color: var(--cm-ink);
    padding-block: var(--cm-memory-pad-top, 3rem) var(--cm-memory-pad-bottom, 3rem);
    overflow: clip;
  }

  .cm-memory__inner {
    display: grid;
    gap: clamp(1.25rem, 3.5vw, 2rem);
    width: min(100% - 1.25rem, 92rem);
    margin-inline: auto;
  }

  .cm-memory__heading {
    margin: 0;
    padding-inline: 0.35rem;
    font-family: var(--font-body--family);
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .cm-memory__grid {
    display: grid;
    gap: 0.85rem;
    align-items: stretch;
  }

  .cm-memory__stack {
    display: grid;
    gap: 0.85rem;
  }

  .cm-memory__frame {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: #111111;
    border: 0.55rem solid #1a1a1a;
    box-shadow:
      0 0.55rem 1.4rem color-mix(in srgb, var(--cm-ink) 18%, transparent),
      0 0.15rem 0.35rem color-mix(in srgb, var(--cm-ink) 12%, transparent);
  }

  .cm-memory__frame--left {
    aspect-ratio: 3 / 4;
  }

  .cm-memory__frame--top,
  .cm-memory__frame--bottom {
    aspect-ratio: 4 / 3;
  }

  .cm-memory__img,
  .cm-memory__empty {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cm-memory__frame--left .cm-memory__img {
    object-position: 62% center;
  }

  .cm-memory__frame--top .cm-memory__img {
    object-position: center 40%;
  }

  .cm-memory__empty {
    background: linear-gradient(145deg, var(--cm-cream), var(--cm-taupe));
    min-height: 12rem;
  }

  .cm-memory__tape {
    position: absolute;
    top: 0.65rem;
    left: 50%;
    translate: -50% 0;
    z-index: 2;
    padding: 0.4rem 0.95rem;
    background: color-mix(in srgb, var(--cm-taupe) 62%, #f3e6d4);
    color: var(--cm-ink);
    font-family: var(--font-subheading--family);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    rotate: -1.5deg;
    box-shadow: 0 0.25rem 0.5rem color-mix(in srgb, var(--cm-ink) 18%, transparent);
  }

  @media screen and (min-width: 900px) {
    .cm-memory__inner {
      width: min(100% - 1.5rem, 96rem);
      gap: clamp(1.5rem, 3vw, 2.25rem);
    }

    .cm-memory__grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      gap: 1.1rem;
    }

    .cm-memory__frame--left {
      min-height: 100%;
      aspect-ratio: auto;
      rotate: -0.6deg;
    }

    .cm-memory__stack {
      gap: 1.1rem;
      padding-block: 0.35rem;
    }

    .cm-memory__frame--top {
      rotate: 1.1deg;
    }

    .cm-memory__frame--bottom {
      rotate: -0.8deg;
    }
  }

  @media (forced-colors: active) {
    .cm-memory__frame {
      border: 0.2rem solid CanvasText;
    }

    .cm-memory__tape {
      forced-color-adjust: none;
      border: 1px solid CanvasText;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CM Memory collage",
  "tag": "section",
  "class": "section-cm-memory",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make a memory."
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image"
    },
    {
      "type": "text",
      "id": "left_alt",
      "label": "Left image alt",
      "default": "Calling Marilyn photobooth"
    },
    {
      "type": "image_picker",
      "id": "right_top_image",
      "label": "Right top image"
    },
    {
      "type": "text",
      "id": "right_top_alt",
      "label": "Right top alt",
      "default": "Photo collage"
    },
    {
      "type": "text",
      "id": "tape_label",
      "label": "Tape label",
      "default": "1-800-SEND-PIC"
    },
    {
      "type": "image_picker",
      "id": "right_bottom_image",
      "label": "Right bottom image"
    },
    {
      "type": "text",
      "id": "right_bottom_alt",
      "label": "Right bottom alt",
      "default": "Photo keepsakes"
    },
    {
      "type": "checkbox",
      "id": "use_fallback_images",
      "label": "Use fallback assets when empty",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "info": "Leave blank for cream."
    }
  ],
  "presets": [
    {
      "name": "CM Memory collage"
    }
  ]
}
{% endschema %}
